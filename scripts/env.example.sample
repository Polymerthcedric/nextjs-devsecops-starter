# Upstash Redis (For Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT Secret for RBAC sessions (HS256). Generate with: openssl rand -base64 32
SESSION_SECRET=generate-a-secure-random-string-here

# CSRF origin validation (strict in production). Set to your canonical host, e.g.
# your-app.vercel.app. Comma-separate extra allowed origins in ALLOWED_ORIGINS
# (e.g. a staging domain).
APP_HOST=
ALLOWED_ORIGINS=

# Public base URL used for SEO (metadata, robots.txt, sitemap.xml), e.g.
# https://your-app.vercel.app — leave unset to fall back to localhost:3000.
NEXT_PUBLIC_APP_URL=

# --- Authentication backend ---
# Configure Supabase for real Postgres-backed users. When both are unset, the
# app falls back to the env-seeded store below so it still demos with no
# external services. See supabase/schema.sql to create the users table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Env-seeded fallback users (used when Supabase is not configured):
# JSON array of { "username", "passwordHash", "role" }.
# Generate a hash with: npm run hash-password -- '<password>'
DEMO_USERS=
# Example:
# DEMO_USERS=[{"username":"admin","passwordHash":"pbkdf2$210000$...","role":"admin"}]

# Default demo user (when DEMO_USERS is unset and Supabase is off):
#   admin / admin123  -> role: admin (accesses /admin)

# --- Paddle Sandbox (open-source demo checkout) ---
# Paddle acts as Merchant of Record. This demo uses Sandbox: no real charges,
# tax filings, or payouts. Server-only key from Developer Tools > Authentication.
# Sandbox keys use https://sandbox-api.paddle.com.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_PRICE_ID=
# Public client token (Developer Tools > Authentication > client-side token).
# A test_... token selects sandbox; a live_... token selects live.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Explicit Paddle.js environment used when the token has no test_/live_ prefix.
# Paddle.js takes this via Paddle.Environment.set(), not Initialize().
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Webhook signing secret. Create the /api/paddle/webhook destination under
# Developer Tools > Event delivery, subscribe to `transaction.completed`,
# and copy the endpoint secret key (pdl_ntfset_...).
PADDLE_WEBHOOK_SECRET=
# NOTE: before hosted checkout works, set + get an APPROVED default payment
# link under Checkout > Checkout settings > Default payment link.